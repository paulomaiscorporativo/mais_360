# Borda da Mais 360: HTTPS automático (Let's Encrypt) na frente do site.
#   • console ({$CONSOLE_HOST}): certificado emitido na subida;
#   • clientes (<slug>.mais.tur.br) e domínios próprios: certificado sob demanda,
#     só depois que a plataforma responder "pode" em /api/tls/ask (docs/DOMINIOS.md).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://web:3000/api/tls/ask
	}
}

(app) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 15s
		# Sem isto o host seria "web:3000", que a plataforma trata como domínio de cliente (404)
		health_headers {
			Host {$CONSOLE_HOST}
		}
	}
}

{$CONSOLE_HOST} {
	import app
}

# WhatsApp (Evolution API, stack em /srv/evolution, rede "edge")
{$EVOLUTION_HOST} {
	encode zstd gzip
	reverse_proxy evolution-api:8080
}

https:// {
	tls {
		on_demand
	}
	import app
}

http:// {
	redir https://{host}{uri} 308
}
