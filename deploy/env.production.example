# Modelo do .env de PRODUÇÃO (fica só no servidor, em /srv/mais360/.env, com chmod 600).
# Nunca commitar o arquivo preenchido. Guia: docs/DEPLOY.md.

# ── Banco gerenciado (DigitalOcean, rede privada/VPC) ──────────────────────────
# Conexão direta (porta 25060): só migrações e seed.
DIRECT_URL="postgresql://mais360_app:SENHA@private-HOST.db.ondigitalocean.com:25060/mais360?sslmode=require"
# Pool PgBouncer "mais360" (porta 25061): site e worker. O compose acrescenta
# pgbouncer=true e o limite de conexões de cada processo.
POOL_URL="postgresql://mais360_app:SENHA@private-HOST.db.ondigitalocean.com:25061/mais360?sslmode=require"

# ── Aplicação ──────────────────────────────────────────────────────────────────
APP_URL="https://360.mais.tur.br"
ROOT_DOMAIN="mais.tur.br"
CONSOLE_HOST="360.mais.tur.br"
CUSTOM_DOMAIN_TARGET=""
DEFAULT_TIMEZONE="America/Sao_Paulo"
# openssl rand -base64 48
AUTH_SECRET=""
# openssl rand -base64 32  (NÃO trocar depois: cifra segredos guardados no banco)
ENCRYPTION_KEY=""

# ── HTTPS (Let's Encrypt) ──────────────────────────────────────────────────────
ACME_EMAIL="ti@maiscorporativo.tur.br"

# ── E-mail (Brevo pela porta 2525: a DigitalOcean bloqueia 25/465/587) ─────────
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mais 360 <nao-responda@mais.tur.br>"
SMTP_REPLY_TO="contato@maiscorporativo.tur.br"

# ── WhatsApp (Evolution) — vazio até a stack da Evolution subir ────────────────
EVOLUTION_URL=""
EVOLUTION_APIKEY=""
EVOLUTION_INSTANCE=""
WHATSAPP_WEBHOOK_SECRET=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# ── Integrações ────────────────────────────────────────────────────────────────
APIFY_TOKEN=""

# ── Seed (só no primeiro deploy; depois pode apagar a senha daqui) ─────────────
SEED_MASTER_EMAIL=""
SEED_MASTER_PASSWORD=""

# ── Operação do worker (docs/OPERACAO.md) ──────────────────────────────────────
WORKER_CONCURRENCY="4"
WORKER_SHUTDOWN_TIMEOUT_MS="45000"
