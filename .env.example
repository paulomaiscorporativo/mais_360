# ── Banco ────────────────────────────────────────────────
DATABASE_URL="postgresql://mais:mais@localhost:5433/mais_dev?schema=public"

# ── Aplicação ────────────────────────────────────────────
# URL pública da plataforma (base de links, QR codes e e-mails)
APP_URL="http://localhost:3000"
# Domínio raiz dos clientes: cada cliente fica em <slug>.<ROOT_DOMAIN>
# (produção: "mais.tur.br" → abiec.mais.tur.br). Em dev: "localhost" (abiec.localhost:3000).
ROOT_DOMAIN="localhost"
# Host do console/produto — NUNCA resolve como cliente. Produção: "360.mais.tur.br".
# Vazio = "360.<ROOT_DOMAIN>". Em dev o console responde em localhost:3000.
CONSOLE_HOST=""
# Domínios próprios dos clientes (eventos.cliente.com.br): host para onde o cliente aponta o
# CNAME. Vazio = "clientes.<ROOT_DOMAIN>". Esse host precisa resolver para o servidor (Caddy).
# Guia completo em docs/DOMINIOS.md.
CUSTOM_DOMAIN_TARGET=""
# Worker: servidores DNS usados na verificação dos domínios, separados por vírgula
# (ex.: "1.1.1.1,8.8.8.8"). Vazio = resolvedor do sistema.
DNS_SERVERS=""
# Segredo das sessões (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-este-segredo-em-producao-com-48-bytes-aleatorios"
# Chave de cifra de segredos guardados no banco (SMTP, Evolution) e biometria — 32 bytes em base64
ENCRYPTION_KEY=""
# Fuso padrão da plataforma (cada projeto pode ter o seu)
DEFAULT_TIMEZONE="America/Sao_Paulo"

# ── Arquivos ─────────────────────────────────────────────
# Pasta persistente FORA da pasta do deploy
STORAGE_DIR="./storage"

# ── E-mail (SMTP global; cada cliente/projeto pode ter o próprio) ──
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mais 360 <nao-responda@mais.tur.br>"
# "Responder para" padrão quando o remetente não recebe respostas e o cliente não definiu o próprio
SMTP_REPLY_TO=""

# ── WhatsApp (Evolution API) ─────────────────────────────
EVOLUTION_URL=""
EVOLUTION_APIKEY=""
# Instância global (usada quando o cliente/projeto não tem a própria)
EVOLUTION_INSTANCE=""

# ── Integrações ──────────────────────────────────────────
APIFY_TOKEN=""
FACE_SERVICE_URL="http://localhost:8100"

# ── Seed: master inicial da plataforma ───────────────────
SEED_MASTER_EMAIL="master@mais.tur.br"
SEED_MASTER_PASSWORD="troque-no-primeiro-acesso"

# ── Webhooks de status do WhatsApp ───────────────────────
# Evolution/webhook genérico: configure a URL .../api/webhooks/whatsapp/evolution?token=<segredo>
WHATSAPP_WEBHOOK_SECRET=""
# Meta Cloud API: segredo do app (assinatura) e token de verificação do webhook
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# ── Operação do worker (docs/OPERACAO.md) ────────────────
# Versão exibida no painel de operação (no deploy, use o sha do commit)
APP_VERSION=""
# Arquivo de marcação do healthcheck do worker (padrão: <tmp>/mais-worker-health)
WORKER_HEALTH_FILE=""
# Prazo para terminar os jobs em andamento no SIGTERM (ms); deixe o stop_grace_period do Docker maior
WORKER_SHUTDOWN_TIMEOUT_MS="45000"
# Limpeza diária: retenção em dias e tamanho do lote (AuditLog e MessageDelivery nunca são apagados)
CLEANUP_SESSION_DAYS="30"
CLEANUP_TOKEN_DAYS="30"
CLEANUP_JOB_DONE_DAYS="14"
CLEANUP_JOB_FAILED_DAYS="60"
CLEANUP_HEARTBEAT_DAYS="7"
CLEANUP_BATCH_SIZE="1000"
